# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Supabase – frontend (public keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Supabase Edge Function secrets – set via `supabase secrets set`
# SUPABASE_URL          (auto-injected by Supabase runtime)
# SUPABASE_ANON_KEY     (auto-injected by Supabase runtime)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# LOVABLE_API_KEY=your-ai-api-key          # used by topic-ai, generate-roadmap, video-studybuddy, generate-artifact, study-assistant
# WOLFRAM_APP_ID=your-wolfram-app-id       # used by wolfram-verify
